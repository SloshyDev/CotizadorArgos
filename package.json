{
  "name": "cotizador-argos-outlook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "certs": "office-addin-dev-certs install",
    "start": "http-server . -p 3000 -c-1",
    "start:https": "http-server . -p 3000 -S -C /Users/sloshy/.office-addin-dev-certs/localhost.crt -K /Users/sloshy/.office-addin-dev-certs/localhost.key -c-1"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "office-addin-dev-certs": "^2.0.10"
  }
}
